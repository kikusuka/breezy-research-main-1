# Breezy & Synthexis Backend Environment Configuration

# Server Port (default: 3000)
PORT=3000

# Primary Gemini AI API Key (Optional if BYOK is used)
GEMINI_API_KEY=

# Additional Model Providers (Optional)
ANTHROPIC_API_KEY=
GROQ_API_KEY=
SAMBANOVA_API_KEY=
OPENROUTER_API_KEY=

# Web Search Grounding Providers (Optional)
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
SEARXNG_URL=

# Local LLM Support (Optional)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# CORS Allowed Origins (Comma-separated URLs; include your production frontend domain and local dev)
ALLOWED_ORIGINS=https://synthexis.yourdomain.com,http://localhost:3000,http://localhost:5173


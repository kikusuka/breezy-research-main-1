{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "breezy-api",
  "main": "workers/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Production frontend domain + local dev origins. Replace 'https://synthexis.yourdomain.com' with your actual domain upon deployment.
    "ALLOWED_ORIGINS": "https://synthexis.yourdomain.com,http://localhost:3000,http://localhost:5173"
  }
}
